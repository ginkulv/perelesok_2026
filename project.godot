config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="perelesok_2026"
run/main_scene="uid://dwg4kahwpqddq"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

GameState="*res://autoloads/game_state.gd"
AudioManager="*res://autoloads/audio_manager.gd"
MessageManager="*res://autoloads/message_manager.gd"
DebugManager="*uid://cr05vtcnkn1ry"
CursorManager="*uid://b0plkurfu24hn"
LevelManager="*uid://dhuv66v0f31tm"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/transparent=true
window/stretch/mode="viewport"
window/per_pixel_transparency/allowed=true

[editor]

movie_writer/movie_file="D:/OBS Vids/gnomejam.avi"
movie_writer/disable_vsync=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

